{
  "name": "walk-it",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Walk It — a visual debugger that renders Python code execution as a walkable 3D world.",
  "author": "Walk It",
  "repository": "github:slopenintercept/WalkIt",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node tests/logic.test.mjs && node tests/all_templates.test.mjs",
    "icon": "node scripts/render-icon.cjs",
    "electron": "electron .",
    "electron:dev": "WALKIT_DEV=1 electron .",
    "app": "npm run build && electron-builder",
    "app:mac": "npm run build && electron-builder --mac",
    "app:win": "npm run build && electron-builder --win",
    "app:linux": "npm run build && electron-builder --linux"
  },
  "build": {
    "appId": "com.walkit.app",
    "productName": "Walk It",
    "afterPack": "scripts/afterPack.cjs",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "slopenintercept",
        "repo": "WalkIt"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      "build/icon.png"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "target": [
        "dmg"
      ]
    },
    "dmg": {
      "title": "Walk It ${version}"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Walk It"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Development",
      "target": [
        "AppImage"
      ]
    }
  },
  "overrides": {
    "@codemirror/state": "6.6.0",
    "@codemirror/view": "6.43.1"
  },
  "dependencies": {
    "@codemirror/lang-python": "6.1.6",
    "@codemirror/state": "6.6.0",
    "@codemirror/view": "6.43.1",
    "@react-three/drei": "9.114.3",
    "@react-three/fiber": "8.17.10",
    "@uiw/react-codemirror": "4.23.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "puppeteer-core": "^25.1.0",
    "pyodide": "^0.26.4",
    "vite": "5.4.11"
  }
}
